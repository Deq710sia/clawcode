{
  "name": "clawcode",
  "version": "0.7.0",
  "description": "ClawCode — universal agentic harness (Electron + OpenCode + WebChat Bridge)",
  "author": "ClawCode",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c magenta,cyan \"vite\" \"wait-on tcp:127.0.0.1:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:vite": "vite",
    "build:electron": "tsc -p electron/tsconfig.json && node scripts/build-preload.mjs",
    "build": "npm run build:electron && vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64",
    "dist:nsis": "npm run build && electron-builder --win nsis --x64",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "highlight.js": "^11.9.0",
    "zustand": "^4.5.1",
    "lucide-react": "^0.331.0",
    "clsx": "^2.1.0",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "@types/cors": "^2.8.17",
    "playwright": "^1.42.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.4.29",
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.clawcode.app",
    "productName": "ClawCode",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "Deq710sia",
      "repo": "clawcode",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/**/*",
      "!node_modules/playwright-core/.local-browsers{,/**}"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "ClawCode-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClawCode"
    },
    "portable": {
      "artifactName": "ClawCode-${version}-portable.exe"
    }
  }
}
